{
  "name": "product-picker-mcp-app",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "MCP App: a credential-gated agentic storefront — a thin reference consumer of @openmobilehub/credentagent-*",
  "bin": {
    "product-picker": "dist/main.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsc -p tsconfig.server.json",
    "start:stdio": "node dist/main.js --stdio",
    "start:http": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openmobilehub/credentagent-gate": "^0.2.0",
    "@openmobilehub/credentagent-storefront": "^0.2.1",
    "@upstash/redis": "^1.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
